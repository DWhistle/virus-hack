# Copy to .env, replace placeholders, then export explicitly (README).
SERVER_MODE=DEV
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=virus_hack_dev
DB_USER=replace_with_local_user
DB_PASSWORD=replace_with_random_local_password
FLASK_SECRET=replace_with_random_secret_at_least_32_characters
# Absolute path; required in PROD, defaults to repository pictures/ in DEV.
# IMAGES_FOLDER=/absolute/path/to/disposable/images
